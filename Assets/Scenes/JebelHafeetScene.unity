--- !u!114 &1897138409
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1897138406}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 08b3abb0d6207db48a20081964542afc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HiliaDialogue
  openIntroductionOnStart: 1
  introduction:
  - speaker: Shamma
    text: It is already dark, and the path is so steep.
    portrait: {fileID: -9194766335657822751, guid: bc57356b113f46e45b17c116df5471f6, type: 3}
  - speaker: Abu Rashid (walkie)
    text: The rocks up there are tired and old. Do not stand still for too long!
    portrait: {fileID: 21300000, guid: ab71d5c27bd25ff49839b64d814a43b0, type: 3}
  - speaker: Abu Rashid (walkie)
    text: Keep climbing. The top is closer than you think.
    portrait: {fileID: 21300000, guid: ab71d5c27bd25ff49839b64d814a43b0, type: 3}
  howToPlay:
  - speaker: Abu Rashid | How to climb
    text: Move with A/D or the arrows. Press Space to jump, and again in the air
      for a second jump. On a phone, use the movement and Jump buttons.
    portrait: {fileID: 21300000, guid: ab71d5c27bd25ff49839b64d814a43b0, type: 3}
  - speaker: Abu Rashid | How to climb
    text: Keep moving on crumbling rocks. Ride the moving platforms upward. Stable
      ledges save your progress if you fall.
    portrait: {fileID: 21300000, guid: ab71d5c27bd25ff49839b64d814a43b0, type: 3}
  hint:
  - speaker: Abu Rashid | Hint
    text: Jump again in the air to reach a higher ledge. Wait for a moving platform
      from a stable rock, then climb aboard.
    portrait: {fileID: 21300000, guid: ab71d5c27bd25ff49839b64d814a43b0, type: 3}
  solved:
  - speaker: Jebel Hafeet
    text: You reached the summit of Jebel Hafeet!
    portrait: {fileID: 0}
  panel: {fileID: 249301552}
  speakerLabel: {fileID: 1201817720}
  wordsLabel: {fileID: 22613455}
  pageLabel: {fileID: 27129802}
  nextLabel: {fileID: 33752721}
  initialsLabel: {fileID: 492026649}
  portrait: {fileID: 1088974802}
  mission: {fileID: 0}
